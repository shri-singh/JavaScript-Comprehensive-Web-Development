{
  "name": "javascript-comprehensive-web-development",
  "version": "1.0.0",
  "private": true,
  "description": "A comprehensive JavaScript web development course — clone, follow chapter-by-chapter, build real projects.",
  "type": "module",
  "workspaces": [
    "projects/*",
    "examples-web/*"
  ],
  "scripts": {
    "dev:forms": "npm -w projects/project-01-forms run dev",
    "dev:search": "npm -w projects/project-02-reactive-search run dev",
    "dev:spa": "npm -w projects/project-03-mini-spa run dev",
    "dev:capstone": "npm -w projects/project-04-capstone run dev",
    "dev:dom": "npm -w examples-web/phase-02 run dev:dom",
    "dev:events": "npm -w examples-web/phase-02 run dev:events",
    "dev:forms-ex": "npm -w examples-web/phase-02 run dev:forms",
    "dev:state": "npm -w examples-web/phase-02 run dev:state",
    "dev:reactivity": "npm -w examples-web/phase-02 run dev:reactivity",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,html,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,md,json}\"",
    "test": "echo \"See individual project directories for tests.\""
  },
  "keywords": ["javascript", "web-development", "course", "tutorial", "es6"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "vite": "^6.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0"
  }
}
